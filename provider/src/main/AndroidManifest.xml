<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.Light">
        
        <!-- 
            步骤1: 无障碍服务
            业务目的：系统级无障碍能力，执行手势操作
        -->
        <service
            android:name=".AccessibilityProviderService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        
        <!--
            步骤2: AIDL 绑定服务
            业务目的：暴露 AIDL 接口供主应用远程调用
        -->
        <service
            android:name=".ProviderBindService"
            android:exported="true">
            <intent-filter>
                <!-- HARD: 这个 Action 必须与主应用 UIHierarchyManager 中的 PROVIDER_ACTION 一致 -->
                <action android:name="com.autoglm.assistant.provider.IAccessibilityProvider" />
            </intent-filter>
        </service>
        
    </application>

</manifest>
